{
  "info": {
    "_postman_id": "oficina-collection-001",
    "name": "Oficina API - MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Cliente",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Fulano\",\n  \"documento\": \"12345678900\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/clientes", "host": ["{{baseUrl}}"], "path": ["clientes"] }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const j = pm.response.json();",
              "pm.test('status 200', ()=> pm.response.to.have.status(200));",
              "pm.test('id is uuidv4', ()=> pm.expect(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(j.id)).to.be.true);",
              "if (j && j.id) pm.environment.set('clienteId', j.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Veiculo",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"placa\": \"ABC1234\",\n  \"modelo\": \"Ka\",\n  \"marca\": \"Ford\",\n  \"ano\": 2015\n}" },
        "url": { "raw": "{{baseUrl}}/veiculos", "host": ["{{baseUrl}}"], "path": ["veiculos"] }
      },
      "response": [],
      "event": [ { "listen": "test", "script": { "exec": [
        "const j = pm.response.json();",
        "pm.test('status 200', ()=> pm.response.to.have.status(200));",
        "pm.test('id is uuidv4', ()=> pm.expect(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(j.id)).to.be.true);",
        "if (j && j.id) pm.environment.set('veiculoId', j.id);"
      ], "type": "text/javascript" } } ]
    },
    {
      "name": "Create OS",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/os", "host": ["{{baseUrl}}"], "path": ["os"] }
      },
      "response": [],
      "event": [ { "listen": "test", "script": { "exec": [
        "const j = pm.response.json();",
        "pm.test('status 200', ()=> pm.response.to.have.status(200));",
        "pm.test('status RECEBIDA', ()=> pm.expect(j.status).to.eql('RECEBIDA'));",
        "if (j && j.id) pm.environment.set('osId', j.id);"
      ], "type": "text/javascript" } } ]
    },
    {
      "name": "List OS",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/os", "host": ["{{baseUrl}}"], "path": ["os"] } },
      "response": [],
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('status 200', ()=> pm.response.to.have.status(200));",
        "const arr = pm.response.json();",
        "pm.test('is array', ()=> pm.expect(arr).to.be.an('array'));
      ], "type": "text/javascript" } } ]
    },
    {
      "name": "Start Diagnostico",
      "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/os/{{osId}}/diagnostico", "host": ["{{baseUrl}}"], "path": ["os","{{osId}}","diagnostico"] } },
      "response": [],
      "event": [ { "listen": "test", "script": { "exec": [
        "const j = pm.response.json();",
        "pm.test('status 200', ()=> pm.response.to.have.status(200));",
        "pm.test('status EM_DIAGNOSTICO', ()=> pm.expect(j.status).to.eql('EM_DIAGNOSTICO'));"
      ], "type": "text/javascript" } } ]
    },
    {
      "name": "Add Item",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"tipo\": \"SERVICO\",\n  \"descricao\": \"Troca de óleo\",\n  \"preco\": 100,\n  \"quantidade\": 1\n}" },
        "url": { "raw": "{{baseUrl}}/os/{{osId}}/item", "host": ["{{baseUrl}}"], "path": ["os","{{osId}}","item"] }
      },
      "response": [],
      "event": [ { "listen": "test", "script": { "exec": [
        "const j = pm.response.json();",
        "pm.test('status 200', ()=> pm.response.to.have.status(200));",
        "pm.test('has itens', ()=> pm.expect(j.itens.length).to.be.above(0));"
      ], "type": "text/javascript" } } ]
    },
    {
      "name": "Gerar Orcamento",
      "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/os/{{osId}}/orcamento", "host": ["{{baseUrl}}"], "path": ["os","{{osId}}","orcamento"] } },
      "response": [],
      "event": [ { "listen": "test", "script": { "exec": [
        "const j = pm.response.json();",
        "pm.test('status AGUARDANDO_APROVACAO', ()=> pm.expect(j.status).to.eql('AGUARDANDO_APROVACAO'));",
        "pm.test('valorTotal > 0', ()=> pm.expect(j.valorTotal).to.be.above(0));"
      ], "type": "text/javascript" } } ]
    },
    {
      "name": "Aprovar Orcamento",
      "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/os/{{osId}}/aprovar", "host": ["{{baseUrl}}"], "path": ["os","{{osId}}","aprovar"] } },
      "response": [],
      "event": [ { "listen": "test", "script": { "exec": [
        "const j = pm.response.json();",
        "pm.test('status APROVADA', ()=> pm.expect(j.status).to.eql('APROVADA'));"
      ], "type": "text/javascript" } } ]
    },
    {
      "name": "Iniciar Execucao",
      "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/os/{{osId}}/executar", "host": ["{{baseUrl}}"], "path": ["os","{{osId}}","executar"] } },
      "response": [],
      "event": [ { "listen": "test", "script": { "exec": [
        "const j = pm.response.json();",
        "pm.test('status EM_EXECUCAO', ()=> pm.expect(j.status).to.eql('EM_EXECUCAO'));"
      ], "type": "text/javascript" } } ]
    },
    {
      "name": "Finalizar",
      "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/os/{{osId}}/finalizar", "host": ["{{baseUrl}}"], "path": ["os","{{osId}}","finalizar"] } },
      "response": [],
      "event": [ { "listen": "test", "script": { "exec": [
        "const j = pm.response.json();",
        "pm.test('status FINALIZADA', ()=> pm.expect(j.status).to.eql('FINALIZADA'));"
      ], "type": "text/javascript" } } ]
    },
    {
      "name": "Entregar",
      "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/os/{{osId}}/entregar", "host": ["{{baseUrl}}"], "path": ["os","{{osId}}","entregar"] } },
      "response": [],
      "event": [ { "listen": "test", "script": { "exec": [
        "const j = pm.response.json();",
        "pm.test('status ENTREGUE', ()=> pm.expect(j.status).to.eql('ENTREGUE'));"
      ], "type": "text/javascript" } } ]
    },
    {
      "name": "Get OS",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/os/{{osId}}", "host": ["{{baseUrl}}"], "path": ["os","{{osId}}"] } },
      "response": [],
      "event": [ { "listen": "test", "script": { "exec": [
        "const j = pm.response.json();",
        "pm.test('returns os', ()=> pm.response.to.have.status(200));",
        "pm.test('final status ENTREGUE', ()=> pm.expect(j.status).to.eql('ENTREGUE'));"
      ], "type": "text/javascript" } } ]
    }
  ]
}
